// dK and dV for 64 keys of one kv head. every query head in its group, and every
// query block from the diagonal on, comes past; K and V fragments stay in
// registers, Q, dO, lse and D stream through two stages. per 16 queries:
//   S^T = K Q^T, P^T = 2^(S^T c - lse), dV += P^T dO
//   dP^T = V dO^T, dS^T = P^T (dP^T - D), dK += dS^T Q
// dk (times 1/sqrt(hd)) and dv go into the k and v parts of dqkv.
// grid (T/64, KVH, B), block 128. block 0 has the most work and goes first anyway
.visible .entry flash_dkv(
    .param .u64 pqkv,
    .param .u64 pdy,
    .param .u64 plse,
    .param .u64 pd,
    .param .u64 pdq,
    .param .u32 pt,
    .param .u32 ph,
    .param .u32 pkvh,
    .param .f32 pscale)
{
    .shared .align 16 .b8 sm[37888];            // 2 stages of Q 9216, dO 9216, lse 256, D 256
    .reg .pred  %p, %pd, %pc;
    .reg .b32   %r<80>;
    .reg .b64   %rd<32>;
    .reg .f32   %f<24>;
    .reg .f32   %s<8>;                          // S^T / P^T, 16 keys x 16 queries
    .reg .f32   %t<8>;                          // dP^T / dS^T
    .reg .f32   %u<32>;                         // dK
    .reg .f32   %v<32>;                         // dV
    .reg .b32   %kf<16>;                        // K fragments (A)
    .reg .b32   %vf<16>;                        // V fragments (A)
    .reg .b32   %k<4>;
    .reg .b32   %a<4>;

    ld.param.u32    %r1, [pt];
    ld.param.u32    %r2, [ph];
    ld.param.u32    %r3, [pkvh];
    ld.param.f32    %f1, [pscale];
    mul.f32         %f2, %f1, 0f3FB8AA3B;       // scale * log2(e)
    mov.f32         %f0, 0f00000000;
    mov.u32         %r4, %tid.x;
    shr.u32         %r5, %r4, 5;
    and.b32         %r6, %r4, 31;
    shr.u32         %r7, %r6, 2;                // g
    and.b32         %r8, %r6, 3;                // t
    mov.u32         %r9, %ctaid.x;              // key block
    mov.u32         %r11, %ctaid.y;             // kv head
    mov.u32         %r12, %ctaid.z;             // b
    div.u32         %r13, %r2, %r3;             // group size
    shl.b32         %r14, %r2, 6;               // QD
    shl.b32         %r15, %r3, 6;               // KVD
    shl.b32         %r16, %r15, 1;
    add.u32         %r16, %r16, %r14;           // QKV
    mul.wide.u32    %rd1, %r16, 2;
    shl.b64         %rd2, %rd1, 4;              // 16 qkv rows
