    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%o24, %o25, %o26, %o27}, {%a0, %a1, %a2, %a3}, {%k0, %k1}, {%o24, %o25, %o26, %o27};
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%o28, %o29, %o30, %o31}, {%a0, %a1, %a2, %a3}, {%k2, %k3}, {%o28, %o29, %o30, %o31};

    cvt.rn.bf16x2.f32 %a0, %s25, %s24;
    cvt.rn.bf16x2.f32 %a1, %s27, %s26;
    cvt.rn.bf16x2.f32 %a2, %s29, %s28;
    cvt.rn.bf16x2.f32 %a3, %s31, %s30;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%k0, %k1, %k2, %k3}, [%r48+6912];
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%o0, %o1, %o2, %o3}, {%a0, %a1, %a2, %a3}, {%k0, %k1}, {%o0, %o1, %o2, %o3};
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%o4, %o5, %o6, %o7}, {%a0, %a1, %a2, %a3}, {%k2, %k3}, {%o4, %o5, %o6, %o7};
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%k0, %k1, %k2, %k3}, [%r48+6944];
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%o8, %o9, %o10, %o11}, {%a0, %a1, %a2, %a3}, {%k0, %k1}, {%o8, %o9, %o10, %o11};
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%o12, %o13, %o14, %o15}, {%a0, %a1, %a2, %a3}, {%k2, %k3}, {%o12, %o13, %o14, %o15};
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%k0, %k1, %k2, %k3}, [%r48+6976];
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%o16, %o17, %o18, %o19}, {%a0, %a1, %a2, %a3}, {%k0, %k1}, {%o16, %o17, %o18, %o19};
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%o20, %o21, %o22, %o23}, {%a0, %a1, %a2, %a3}, {%k2, %k3}, {%o20, %o21, %o22, %o23};
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%k0, %k1, %k2, %k3}, [%r48+7008];
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%o24, %o25, %o26, %o27}, {%a0, %a1, %a2, %a3}, {%k0, %k1}, {%o24, %o25, %o26, %o27};
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%o28, %o29, %o30, %o31}, {%a0, %a1, %a2, %a3}, {%k2, %k3}, {%o28, %o29, %o30, %o31};

    bar.sync        0;                          // done with this stage before it refills
    add.u32         %r43, %r43, 1;
    setp.le.u32     %p, %r43, %r9;
    @%p bra         kloop;

    // finish the row sums across the 4 threads of each row, then O / l
    shfl.sync.bfly.b32 %f8, %f4, 1, 31, 0xffffffff;
    add.f32         %f4, %f4, %f8;
    shfl.sync.bfly.b32 %f8, %f4, 2, 31, 0xffffffff;
    add.f32         %f4, %f4, %f8;
    shfl.sync.bfly.b32 %f8, %f5, 1, 31, 0xffffffff;
    add.f32         %f5, %f5, %f8;
    shfl.sync.bfly.b32 %f8, %f5, 2, 31, 0xffffffff;
    add.f32         %f5, %f5, %f8;
    rcp.rn.f32      %f11, %f4;
    rcp.rn.f32      %f12, %f5;
    mul.f32 %o0, %o0, %f11;   mul.f32 %o1, %o1, %f11;   mul.f32 %o2, %o2, %f12;   mul.f32 %o3, %o3, %f12;
    mul.f32 %o4, %o4, %f11;   mul.f32 %o5, %o5, %f11;   mul.f32 %o6, %o6, %f12;   mul.f32 %o7, %o7, %f12;
    mul.f32 %o8, %o8, %f11;   mul.f32 %o9, %o9, %f11;   mul.f32 %o10, %o10, %f12; mul.f32 %o11, %o11, %f12;
    mul.f32 %o12, %o12, %f11; mul.f32 %o13, %o13, %f11; mul.f32 %o14, %o14, %f12; mul.f32 %o15, %o15, %f12;
    mul.f32 %o16, %o16, %f11; mul.f32 %o17, %o17, %f11; mul.f32 %o18, %o18, %f12; mul.f32 %o19, %o19, %f12;
    mul.f32 %o20, %o20, %f11; mul.f32 %o21, %o21, %f11; mul.f32 %o22, %o22, %f12; mul.f32 %o23, %o23, %f12;
    mul.f32 %o24, %o24, %f11; mul.f32 %o25, %o25, %f11; mul.f32 %o26, %o26, %f12; mul.f32 %o27, %o27, %f12;
    mul.f32 %o28, %o28, %f11; mul.f32 %o29, %o29, %f11; mul.f32 %o30, %o30, %f12; mul.f32 %o31, %o31, %f12;

    // y rows q0 + w*16 + g (+8), cols h*64 + nt*8 + 2t
    shl.b32         %r49, %r9, 6;
    add.u32         %r49, %r49, %r39;           // query t for row g
    add.u32         %r50, %r17, %r49;           // m
    shl.b32         %r51, %r11, 6;
    add.u32         %r51, %r51, %r40;
    mad.lo.u32      %r52, %r50, %r14, %r51;
    ld.param.u64    %rd9, [py];
    mul.wide.u32    %rd10, %r52, 2;
    add.u64         %rd10, %rd9, %rd10;         // row g
    mul.wide.u32    %rd11, %r14, 16;
    add.u64         %rd11, %rd10, %rd11;        // row g+8
    cvt.rn.bf16x2.f32 %r53, %o1, %o0;
    st.global.b32   [%rd10], %r53;
    cvt.rn.bf16x2.f32 %r53, %o3, %o2;
    st.global.b32   [%rd11], %r53;
    cvt.rn.bf16x2.f32 %r53, %o5, %o4;
    st.global.b32   [%rd10+16], %r53;
    cvt.rn.bf16x2.f32 %r53, %o7, %o6;
    st.global.b32   [%rd11+16], %r53;
    cvt.rn.bf16x2.f32 %r53, %o9, %o8;
    st.global.b32   [%rd10+32], %r53;
    cvt.rn.bf16x2.f32 %r53, %o11, %o10;
    st.global.b32   [%rd11+32], %r53;
    cvt.rn.bf16x2.f32 %r53, %o13, %o12;
    st.global.b32   [%rd10+48], %r53;
    cvt.rn.bf16x2.f32 %r53, %o15, %o14;
    st.global.b32   [%rd11+48], %r53;
    cvt.rn.bf16x2.f32 %r53, %o17, %o16;
    st.global.b32   [%rd10+64], %r53;
    cvt.rn.bf16x2.f32 %r53, %o19, %o18;
    st.global.b32   [%rd11+64], %r53;
    cvt.rn.bf16x2.f32 %r53, %o21, %o20;
    st.global.b32   [%rd10+80], %r53;
    cvt.rn.bf16x2.f32 %r53, %o23, %o22;
    st.global.b32   [%rd11+80], %r53;
    cvt.rn.bf16x2.f32 %r53, %o25, %o24;
    st.global.b32   [%rd10+96], %r53;
    cvt.rn.bf16x2.f32 %r53, %o27, %o26;
    st.global.b32   [%rd11+96], %r53;
    cvt.rn.bf16x2.f32 %r53, %o29, %o28;
    st.global.b32   [%rd10+112], %r53;
    cvt.rn.bf16x2.f32 %r53, %o31, %o30;
    st.global.b32   [%rd11+112], %r53;

    // lse = (m + log2 l) ln 2, by the t == 0 thread of each row
    setp.ne.u32     %p, %r8, 0;
    @%p bra         done;
    lg2.approx.f32  %f13, %f4;
    add.f32         %f13, %f13, %f2;
    mul.f32         %f13, %f13, 0f3F317218;
    lg2.approx.f32  %f14, %f5;
    add.f32         %f14, %f14, %f3;
    mul.f32         %f14, %f14, 0f3F317218;
    mad.lo.u32      %r54, %r12, %r2, %r11;      // b*H + h
    mad.lo.u32      %r54, %r54, %r1, %r49;
    ld.param.u64    %rd12, [plse];
    mul.wide.u32    %rd13, %r54, 4;
    add.u64         %rd12, %rd12, %rd13;
    st.global.f32   [%rd12], %f13;
    st.global.f32   [%rd12+32], %f14;
done:
    ret;
}

// attention backward needs D = dy . y per query and head (it's also sum_j P dP).
// one thread per (row, head), 64 products each. same layout as lse: [B][H][T]
.visible .entry attn_d(
    .param .u64 pdy,
    .param .u64 py,
    .param .u64 pd,
    .param .u32 pm,
    .param .u32 pt,
    .param .u32 ph)
{
    .reg .pred  %p;
    .reg .b32   %r<24>;
    .reg .b64   %rd<12>;
    .reg .f32   %f<8>;

    ld.param.u32    %r1, [pm];
    ld.param.u32    %r2, [pt];
    ld.param.u32    %r3, [ph];
    mov.u32         %r4, %ctaid.x;
    mov.u32         %r5, %ntid.x;
    mov.u32         %r6, %tid.x;
    mad.lo.u32      %r7, %r4, %r5, %r6;
    mul.lo.u32      %r8, %r1, %r3;
    setp.ge.u32     %p, %r7, %r8;
    @%p bra         done;
    rem.u32         %r9, %r7, %r3;              // h
    div.u32         %r10, %r7, %r3;             // m
    // y and dy rows are QD = H*64 wide, so (m, h) starts at element i*64
    mul.wide.u32    %rd1, %r7, 128;
    ld.param.u64    %rd2, [pdy];
    add.u64         %rd2, %rd2, %rd1;
    ld.param.u64    %rd3, [py];
    add.u64         %rd3, %rd3, %rd1;
    mov.f32         %f1, 0f00000000;
    mov.u32         %r11, 0;
dl:
    ld.global.b32   %r12, [%rd2];
    ld.global.b32   %r13, [%rd3];
    shl.b32         %r14, %r12, 16;
    shl.b32         %r15, %r13, 16;
    mov.b32         %f2, %r14;
    mov.b32         %f3, %r15;
    fma.rn.f32      %f1, %f2, %f3, %f1;
    and.b32         %r14, %r12, 0xffff0000;
    and.b32         %r15, %r13, 0xffff0000;
    mov.b32         %f2, %r14;
    mov.b32         %f3, %r15;
    fma.rn.f32      %f1, %f2, %f3, %f1;
    add.u64         %rd2, %rd2, 4;
    add.u64         %rd3, %rd3, 4;
    add.u32         %r11, %r11, 1;
    setp.lt.u32     %p, %r11, 32;
    @%p bra         dl;
    div.u32         %r16, %r10, %r2;            // b
    rem.u32         %r17, %r10, %r2;            // t
    mad.lo.u32      %r18, %r16, %r3, %r9;
    mad.lo.u32      %r18, %r18, %r2, %r17;
    ld.param.u64    %rd4, [pd];
    mul.wide.u32    %rd5, %r18, 4;
    add.u64         %rd4, %rd4, %rd5;
    st.global.f32   [%rd4], %f1;
done:
    ret;
}

// dQ for 64 queries of one head, walking the key blocks up to the diagonal.
// Q and dO fragments stay in registers, K and V stream through two stages. per
// 16 keys: S = Q K^T and dP = dO V^T (mma), P = 2^(S log2e/sqrt(hd) - lse log2e),
// dS = P (dP - D), dQ += dS K (K as B transposed: ldmatrix.trans).
// dq goes into the q part of dqkv, times 1/sqrt(hd).
// grid (T/64, H, B), block 128
.visible .entry flash_dq(
    .param .u64 pqkv,
    .param .u64 pdy,
    .param .u64 plse,
    .param .u64 pd,
    .param .u64 pdq,
    .param .u32 pt,
    .param .u32 ph,
    .param .u32 pkvh,
    .param .f32 pscale)
{
    .shared .align 16 .b8 sm[36864];            // 2 stages of K 9216 + V 9216. Q, dO start in stage 1
    .reg .pred  %p, %pd;
    .reg .b32   %r<64>;
    .reg .b64   %rd<24>;
    .reg .f32   %f<24>;
    .reg .f32   %s<8>;                          // S / P for 16 keys, tile nt j is s[4nt + j]
    .reg .f32   %t<8>;                          // dP / dS
    .reg .f32   %u<32>;                         // dQ, hd tile nt j is u[4nt + j]
    .reg .b32   %q<16>;                         // Q fragments, k step kk is q[4kk ..]
    .reg .b32   %e<16>;                         // dO fragments
    .reg .b32   %k<4>;
    .reg .b32   %a<4>;

    ld.param.u32    %r1, [pt];
    ld.param.u32    %r2, [ph];
    ld.param.u32    %r3, [pkvh];
    ld.param.f32    %f1, [pscale];
    mul.f32         %f2, %f1, 0f3FB8AA3B;       // scale * log2(e)
    mov.f32         %f0, 0f00000000;
    mov.u32         %r4, %tid.x;
    shr.u32         %r5, %r4, 5;
    and.b32         %r6, %r4, 31;
    shr.u32         %r7, %r6, 2;                // g
    and.b32         %r8, %r6, 3;                // t
    mov.u32         %r9, %nctaid.x;
    mov.u32         %r10, %ctaid.x;
    sub.u32         %r9, %r9, %r10;
    sub.u32         %r9, %r9, 1;                // query block, heaviest first
    mov.u32         %r11, %ctaid.y;             // h
    mov.u32         %r12, %ctaid.z;             // b
    div.u32         %r13, %r2, %r3;
    div.u32         %r13, %r11, %r13;           // kv head
    shl.b32         %r14, %r2, 6;               // QD
    shl.b32         %r15, %r3, 6;               // KVD
    shl.b32         %r16, %r15, 1;
    add.u32         %r16, %r16, %r14;           // QKV
    mul.wide.u32    %rd1, %r16, 2;
    shl.b64         %rd2, %rd1, 4;              // 16 qkv rows
    shl.b64         %rd3, %rd1, 6;              // 64
    mul.wide.u32    %rd14, %r14, 32;            // 16 dy rows
    mul.lo.u32      %r17, %r12, %r1;            // b*T

    // copying: rows tid/8 + 16i, 8 bf16 at (tid%8)*8
    shr.u32         %r18, %r4, 3;
    and.b32         %r19, %r4, 7;
    shl.b32         %r19, %r19, 3;
    mov.u32         %r20, sm;
    mad.lo.u32      %r21, %r18, 144, %r20;
    shl.b32         %r22, %r19, 1;
    add.u32         %r21, %r21, %r22;           // copy dst, stage 0 K
    shl.b32         %r23, %r9, 6;               // q0
    add.u32         %r24, %r17, %r23;
    add.u32         %r24, %r24, %r18;
    ld.param.u64    %rd4, [pqkv];
    mul.lo.u32      %r25, %r24, %r16;
    shl.b32         %r26, %r11, 6;
    add.u32         %r25, %r25, %r26;
    add.u32         %r25, %r25, %r19;
    mul.wide.u32    %rd5, %r25, 2;
    add.u64         %rd5, %rd4, %rd5;           // Q
    ld.param.u64    %rd15, [pdy];
    mul.lo.u32      %r25, %r24, %r14;
    add.u32         %r25, %r25, %r26;
    add.u32         %r25, %r25, %r19;
    mul.wide.u32    %rd16, %r25, 2;
    add.u64         %rd15, %rd15, %rd16;        // dO
    add.u32         %r24, %r17, %r18;
    mul.lo.u32      %r25, %r24, %r16;
    add.u32         %r25, %r25, %r14;
    shl.b32         %r26, %r13, 6;
    add.u32         %r25, %r25, %r26;
    add.u32         %r25, %r25, %r19;
    mul.wide.u32    %rd6, %r25, 2;
    add.u64         %rd6, %rd4, %rd6;           // K, block 0
    mul.wide.u32    %rd7, %r15, 2;
    add.u64         %rd7, %rd6, %rd7;           // V

    add.u32         %r27, %r21, 18432;
    cp.async.cg.shared.global [%r27], [%rd5], 16;
    add.u64         %rd8, %rd5, %rd2;
    cp.async.cg.shared.global [%r27+2304], [%rd8], 16;
    add.u64         %rd8, %rd8, %rd2;
    cp.async.cg.shared.global [%r27+4608], [%rd8], 16;
    add.u64         %rd8, %rd8, %rd2;
    cp.async.cg.shared.global [%r27+6912], [%rd8], 16;
    cp.async.cg.shared.global [%r27+9216], [%rd15], 16;
    add.u64         %rd8, %rd15, %rd14;
    cp.async.cg.shared.global [%r27+11520], [%rd8], 16;
    add.u64         %rd8, %rd8, %rd14;
    cp.async.cg.shared.global [%r27+13824], [%rd8], 16;
    add.u64         %rd8, %rd8, %rd14;
    cp.async.cg.shared.global [%r27+16128], [%rd8], 16;
    cp.async.cg.shared.global [%r21], [%rd6], 16;
    add.u64         %rd8, %rd6, %rd2;
    cp.async.cg.shared.global [%r21+2304], [%rd8], 16;
    add.u64         %rd8, %rd8, %rd2;
    cp.async.cg.shared.global [%r21+4608], [%rd8], 16;
    add.u64         %rd8, %rd8, %rd2;
    cp.async.cg.shared.global [%r21+6912], [%rd8], 16;
    cp.async.cg.shared.global [%r21+9216], [%rd7], 16;
    add.u64         %rd8, %rd7, %rd2;
    cp.async.cg.shared.global [%r21+11520], [%rd8], 16;
    add.u64         %rd8, %rd8, %rd2;
    cp.async.cg.shared.global [%r21+13824], [%rd8], 16;
    add.u64         %rd8, %rd8, %rd2;
    cp.async.cg.shared.global [%r21+16128], [%rd8], 16;
    cp.async.commit_group;
    add.u64         %rd6, %rd6, %rd3;
    add.u64         %rd7, %rd7, %rd3;

    // lse (into log2 units) and D for rows g and g+8
    mad.lo.u32      %r39, %r5, 16, %r7;         // w*16 + g
    mad.lo.u32      %r40, %r12, %r2, %r11;
    mad.lo.u32      %r40, %r40, %r1, %r23;
    add.u32         %r40, %r40, %r39;
    mul.wide.u32    %rd9, %r40, 4;
    ld.param.u64    %rd10, [plse];
    add.u64         %rd10, %rd10, %rd9;
    ld.global.f32   %f3, [%rd10];
    ld.global.f32   %f4, [%rd10+32];
    mul.f32         %f3, %f3, 0f3FB8AA3B;
    mul.f32         %f4, %f4, 0f3FB8AA3B;
    ld.param.u64    %rd11, [pd];
    add.u64         %rd11, %rd11, %rd9;
    ld.global.f32   %f5, [%rd11];
    ld.global.f32   %f6, [%rd11+32];

    // ldmatrix bases. A (Q, dO in stage 1): row w*16 + lane%16, col (lane/16)*8
    and.b32         %r28, %r6, 15;
    mad.lo.u32      %r28, %r5, 16, %r28;
    mad.lo.u32      %r28, %r28, 144, %r20;
    shr.u32         %r29, %r6, 4;
    shl.b32         %r30, %r29, 4;
    add.u32         %r28, %r28, %r30;
    add.u32         %r28, %r28, 18432;
    // B from [key][hd] (K for S, V for dP): key lane%8 + (lane/16)*8, hd ((lane/8)%2)*8
    and.b32         %r31, %r6, 7;
    shl.b32         %r32, %r29, 3;
    add.u32         %r32, %r32, %r31;
    shr.u32         %r33, %r6, 3;
    and.b32         %r33, %r33, 1;
    mad.lo.u32      %r34, %r32, 144, %r20;
    shl.b32         %r35, %r33, 4;
    add.u32         %r34, %r34, %r35;           // aK
    // B transposed (K for dQ): key lane%8 + ((lane/8)%2)*8, hd (lane/16)*8
    shl.b32         %r36, %r33, 3;
    add.u32         %r36, %r36, %r31;
    mad.lo.u32      %r37, %r36, 144, %r20;
    shl.b32         %r38, %r29, 4;
    add.u32         %r37, %r37, %r38;           // aKt

    // mask: key 8nt + 2t (+1) of a chunk after row d0 (d1 for row g+8)
    shl.b32         %r41, %r8, 1;
    sub.s32         %r42, %r39, %r41;           // d0
    add.s32         %r43, %r42, 8;              // d1

    cp.async.wait_group 0;
    bar.sync        0;
