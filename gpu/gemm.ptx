    add.u32         %r54, %r36, %r50;           // mi 1
    add.u32         %r55, %r54, %r50;           // mi 2
    add.u32         %r56, %r55, %r50;           // mi 3
    add.u32         %r37, %r30, %r35;           // B, n tiles 0-1
    add.u32         %r57, %r37, %r52;           // n tiles 2-3

    // k 0..15 of the tile
    @!%pta ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%ra0, %ra1, %ra2, %ra3}, [%r36];
    @%pta  ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%ra0, %ra1, %ra2, %ra3}, [%r36];
