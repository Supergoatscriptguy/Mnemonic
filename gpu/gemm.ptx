    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%f36, %f37, %f38, %f39}, {%ra8, %ra9, %ra10, %ra11}, {%rb2, %rb3}, {%f36, %f37, %f38, %f39};
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%f40, %f41, %f42, %f43}, {%ra8, %ra9, %ra10, %ra11}, {%rb4, %rb5}, {%f40, %f41, %f42, %f43};
