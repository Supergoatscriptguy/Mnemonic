    @%p bra         last;
    and.b32         %r33, %r32, 1;
    mul.lo.u32      %r33, %r33, 20480;
    add.u32         %r34, %r16, %r33;
    cp.async.cg.shared.global [%r34], [%rd5], 16;
    add.u32         %r34, %r17, %r33;
    cp.async.cg.shared.global [%r34], [%rd7], 16;
    add.u32         %r34, %r18, %r33;
    cp.async.cg.shared.global [%r34], [%rd8], 16;
    add.u32         %r34, %r19, %r33;
    cp.async.cg.shared.global [%r34], [%rd9], 16;
