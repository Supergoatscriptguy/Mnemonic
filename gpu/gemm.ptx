// matmul, three ways. all compute C = A * W^T:
//   A is M x K bf16, W is N x K bf16 (a linear layer's weight, one row per output),
//   C is M x N f32, everything row major.
// gemm_ref is the reference, gemm_mma1 the first tensor core version, gemm_tc the real one

// the reference: one thread per output, a plain fp32 fma loop over k.
// slow and obviously right. block 16 x 16, grid (N/16, M/16) rounded up
.visible .entry gemm_ref(
    .param .u64 pa,
    .param .u64 pw,
    .param .u64 pc,
    .param .u32 pm,
    .param .u32 pn,
    .param .u32 pk)
{
    .reg .pred  %p<3>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<10>;
    .reg .f32   %f<4>;

    ld.param.u64    %rd1, [pa];
    ld.param.u64    %rd2, [pw];
    ld.param.u64    %rd3, [pc];
    ld.param.u32    %r1, [pm];
    ld.param.u32    %r2, [pn];
    ld.param.u32    %r3, [pk];
    mov.u32         %r4, %ctaid.x;
    mov.u32         %r5, %tid.x;
    mad.lo.u32      %r6, %r4, 16, %r5;          // n
    mov.u32         %r4, %ctaid.y;
    mov.u32         %r5, %tid.y;
    mad.lo.u32      %r7, %r4, 16, %r5;          // m
    setp.ge.u32     %p1, %r6, %r2;
    setp.ge.u32     %p2, %r7, %r1;
    or.pred         %p1, %p1, %p2;
    @%p1 bra        done;
    mul.lo.u32      %r8, %r7, %r3;
    mul.wide.u32    %rd4, %r8, 2;
    add.u64         %rd5, %rd1, %rd4;           // &A[m][0]
    mul.lo.u32      %r8, %r6, %r3;
    mul.wide.u32    %rd4, %r8, 2;
    add.u64         %rd6, %rd2, %rd4;           // &W[n][0]
    mov.f32         %f1, 0f00000000;
    mov.u32         %r9, 0;
kloop:
    setp.ge.u32     %p1, %r9, %r3;
    @%p1 bra        kdone;
    ld.global.u16   %r10, [%rd5];
    ld.global.u16   %r11, [%rd6];
    shl.b32         %r10, %r10, 16;             // a bf16 is the top half of an f32
    shl.b32         %r11, %r11, 16;
    mov.b32         %f2, %r10;
    mov.b32         %f3, %r11;
    fma.rn.f32      %f1, %f2, %f3, %f1;
    add.u64         %rd5, %rd5, 2;
    add.u64         %rd6, %rd6, 2;
    add.u32         %r9, %r9, 1;
    bra             kloop;
kdone:
    mad.lo.u32      %r8, %r7, %r2, %r6;         // m*N + n
    mul.wide.u32    %rd4, %r8, 4;
    add.u64         %rd7, %rd3, %rd4;
    st.global.f32   [%rd7], %f1;
done:
    ret;
}

// first tensor core version: one warp per 16x8 tile of C, fragments loaded straight
// from global memory. slow, but it spells out where every element lives.
// lane = 4g + t:
//   A fragment: rows g and g+8, k pairs 2t and 2t+8   (4 regs, 2 bf16 each)
//   B fragment: column n = g, k pairs 2t and 2t+8     (2 regs)
//   C fragment: rows g and g+8, columns 2t, 2t+1      (4 floats)
// W is stored n-major, which is exactly the "col" layout the B operand wants, so
// every fragment register is one aligned 32 bit load.
// grid (N/8, M/16), block 32. needs M%16 == 0, N%8 == 0, K%16 == 0
.visible .entry gemm_mma1(
    .param .u64 pa,
    .param .u64 pw,
    .param .u64 pc,
    .param .u32 pm,
    .param .u32 pn,
    .param .u32 pk)
{
    .reg .pred  %p;
    .reg .b32   %r<24>;
    .reg .b64   %rd<16>;
    .reg .f32   %f<4>;

    ld.param.u64    %rd1, [pa];
    ld.param.u64    %rd2, [pw];
    ld.param.u64    %rd3, [pc];
    ld.param.u32    %r2, [pn];
    ld.param.u32    %r3, [pk];
    mov.u32         %r4, %tid.x;
    shr.u32         %r5, %r4, 2;                // g
    and.b32         %r6, %r4, 3;                // t
    mov.u32         %r7, %ctaid.y;
    shl.b32         %r7, %r7, 4;                // m0
    mov.u32         %r8, %ctaid.x;
    shl.b32         %r8, %r8, 3;                // n0
    shl.b32         %r11, %r6, 1;               // 2t
    add.u32         %r9, %r7, %r5;              // m0 + g
    mad.lo.u32      %r10, %r9, %r3, %r11;
    mul.wide.u32    %rd4, %r10, 2;
    add.u64         %rd5, %rd1, %rd4;           // &A[m0+g][2t]
    shl.b32         %r12, %r3, 4;               // 8 rows of A in bytes
    cvt.u64.u32     %rd6, %r12;
    add.u64         %rd7, %rd5, %rd6;           // &A[m0+g+8][2t]
    add.u32         %r13, %r8, %r5;             // n0 + g
    mad.lo.u32      %r14, %r13, %r3, %r11;
    mul.wide.u32    %rd8, %r14, 2;
    add.u64         %rd9, %rd2, %rd8;           // &W[n0+g][2t]
    mov.f32         %f0, 0f00000000;
    mov.f32         %f1, 0f00000000;
    mov.f32         %f2, 0f00000000;
    mov.f32         %f3, 0f00000000;
    mov.u32         %r15, 0;
kloop:
    setp.ge.u32     %p, %r15, %r3;
    @%p bra         store;
    ld.global.b32   %r16, [%rd5];               // a0: row g,   k 2t..
    ld.global.b32   %r17, [%rd7];               // a1: row g+8, k 2t..
    ld.global.b32   %r18, [%rd5+16];            // a2: row g,   k 2t+8..
    ld.global.b32   %r19, [%rd7+16];            // a3: row g+8, k 2t+8..
    ld.global.b32   %r20, [%rd9];               // b0: n g, k 2t..
    ld.global.b32   %r21, [%rd9+16];            // b1: n g, k 2t+8..
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32
        {%f0, %f1, %f2, %f3}, {%r16, %r17, %r18, %r19}, {%r20, %r21}, {%f0, %f1, %f2, %f3};
    add.u64         %rd5, %rd5, 32;
    add.u64         %rd7, %rd7, 32;
    add.u64         %rd9, %rd9, 32;
    add.u32         %r15, %r15, 16;
    bra             kloop;
store:
    add.u32         %r22, %r8, %r11;            // n0 + 2t
    mad.lo.u32      %r23, %r9, %r2, %r22;       // (m0+g)*N + n0 + 2t
    mul.wide.u32    %rd10, %r23, 4;
    add.u64         %rd11, %rd3, %rd10;
    st.global.v2.f32 [%rd11], {%f0, %f1};
    shl.b32         %r12, %r2, 5;               // 8 rows of C in bytes
    cvt.u64.u32     %rd12, %r12;
    add.u64         %rd13, %rd11, %rd12;
    st.global.v2.f32 [%rd13], {%f2, %f3};
    ret;
}

// the real one. each block does a 128x128 tile of C, going through K 32 at a time.
// 256 threads = 8 warps, arranged 2 (m) x 4 (n), so each warp owns 64x32 of C:
// 4 x 4 mma tiles, 64 accumulators per thread.
//  - global -> shared with cp.async (16 bytes each, no registers involved), in two
//    stages: the next k tile streams in while this one is being multiplied
//  - shared -> registers with ldmatrix.x4, which hands out exactly the mma
//    fragment layout. .trans does the same for an operand stored the other way
//    round, so every layout the model needs runs at the same speed:
//      flag 1: A stored [K][M] (A^T),  flag 2: B stored [K][N]
//    forward x W^T is neither, dx = dy W is flag 2, dW = dy^T x is both
//  - flag 4: C comes out as bf16. pr (f32, optional): C = R + A B^T, done by
//    starting the accumulators at R. R can be C, which is how gradients add up
//  - untransposed tiles are 128 rows of 32 k, padded to 40 (80 bytes), so the 8
//    rows one ldmatrix reads start in 8 different 4-bank groups: no conflicts.
//    transposed ones are 32 k-rows of 128, padded to 136 (272 bytes), same idea
// shared per stage: A (10240 bytes max) + B = 20480, two stages.
// grid (N/128, M/128), block 256. needs M%128 == 0, N%128 == 0, K%32 == 0
.visible .entry gemm_tc(
    .param .u64 pa,
    .param .u64 pw,
    .param .u64 pc,
    .param .u32 pm,
    .param .u32 pn,
    .param .u32 pk,
    .param .u64 pr,
    .param .u32 pf)
{
    .shared .align 16 .b8 sm[40960];
    .reg .pred  %p, %pta, %ptb, %pbf, %pr;
    .reg .b32   %r<80>;
    .reg .b64   %rd<40>;
    .reg .f32   %f<64>;                         // accumulator (mi, ni, j) is f[16mi + 4ni + j]
    .reg .b32   %ra<16>;                        // A fragment (mi, j) is ra[4mi + j]
    .reg .b32   %rb<8>;                         // B fragment (ni, j) is rb[2ni + j]

    ld.param.u64    %rd1, [pa];
    ld.param.u64    %rd2, [pw];
    ld.param.u64    %rd3, [pc];
    ld.param.u32    %r1, [pm];
    ld.param.u32    %r2, [pn];
    ld.param.u32    %r3, [pk];
    ld.param.u64    %rd30, [pr];
    setp.ne.u64     %pr, %rd30, 0;
    ld.param.u32    %r60, [pf];
    and.b32         %r61, %r60, 1;
    setp.ne.u32     %pta, %r61, 0;
    and.b32         %r61, %r60, 2;
    setp.ne.u32     %ptb, %r61, 0;
    and.b32         %r61, %r60, 4;
    setp.ne.u32     %pbf, %r61, 0;
    mov.u32         %r4, %tid.x;
    shr.u32         %r5, %r4, 5;                // warp
    and.b32         %r6, %r4, 31;               // lane
    mov.u32         %r7, %ctaid.y;
    shl.b32         %r7, %r7, 7;                // bm
    mov.u32         %r8, %ctaid.x;
    shl.b32         %r8, %r8, 7;                // bn
    mov.u32         %r9, sm;

    // what this thread copies, 16 bytes at a time: two rows of the A tile and two
    // of the B tile. gA0/gA1 (rd5, rd7) -> sA0/sA1 (r16, r17), step per k tile rd20
    @%pta bra       acopyt;
    shr.u32         %r10, %r4, 2;               // rows r and r+64, 8 k at (tid%4)*8
    and.b32         %r11, %r4, 3;
    shl.b32         %r11, %r11, 3;
    add.u32         %r12, %r7, %r10;
    mad.lo.u32      %r12, %r12, %r3, %r11;
    mul.wide.u32    %rd4, %r12, 2;
    add.u64         %rd5, %rd1, %rd4;
    shl.b32         %r13, %r3, 7;               // 64 rows
    cvt.u64.u32     %rd6, %r13;
    add.u64         %rd7, %rd5, %rd6;
    mov.u64         %rd20, 64;                  // 32 k
    mul.lo.u32      %r14, %r10, 80;
    shl.b32         %r15, %r11, 1;
    add.u32         %r14, %r14, %r15;
    add.u32         %r16, %r9, %r14;
    add.u32         %r17, %r16, 5120;
    bra             acopyd;
acopyt:
    shr.u32         %r10, %r4, 4;               // k rows r and r+16, 8 m at (tid%16)*8
    and.b32         %r11, %r4, 15;
    shl.b32         %r11, %r11, 3;
    add.u32         %r12, %r7, %r11;
    mad.lo.u32      %r12, %r10, %r1, %r12;
    mul.wide.u32    %rd4, %r12, 2;
    add.u64         %rd5, %rd1, %rd4;
    shl.b32         %r13, %r1, 5;               // 16 rows
    cvt.u64.u32     %rd6, %r13;
    add.u64         %rd7, %rd5, %rd6;
    mul.wide.u32    %rd20, %r1, 64;             // 32 rows
    mul.lo.u32      %r14, %r10, 272;
    shl.b32         %r15, %r11, 1;
    add.u32         %r14, %r14, %r15;
    add.u32         %r16, %r9, %r14;
    add.u32         %r17, %r16, 4352;
acopyd:
    @%ptb bra       bcopyt;
    shr.u32         %r10, %r4, 2;
    and.b32         %r11, %r4, 3;
    shl.b32         %r11, %r11, 3;
    add.u32         %r12, %r8, %r10;
    mad.lo.u32      %r12, %r12, %r3, %r11;
    mul.wide.u32    %rd4, %r12, 2;
    add.u64         %rd8, %rd2, %rd4;
    shl.b32         %r13, %r3, 7;
    cvt.u64.u32     %rd6, %r13;
    add.u64         %rd9, %rd8, %rd6;
    mov.u64         %rd21, 64;
    mul.lo.u32      %r14, %r10, 80;
    shl.b32         %r15, %r11, 1;
    add.u32         %r14, %r14, %r15;
    add.u32         %r18, %r9, %r14;
    add.u32         %r18, %r18, 10240;
    add.u32         %r19, %r18, 5120;
    bra             bcopyd;
bcopyt:
    shr.u32         %r10, %r4, 4;
    and.b32         %r11, %r4, 15;
    shl.b32         %r11, %r11, 3;
    add.u32         %r12, %r8, %r11;
    mad.lo.u32      %r12, %r10, %r2, %r12;
    mul.wide.u32    %rd4, %r12, 2;
    add.u64         %rd8, %rd2, %rd4;
    shl.b32         %r13, %r2, 5;
    cvt.u64.u32     %rd6, %r13;
    add.u64         %rd9, %rd8, %rd6;
    mul.wide.u32    %rd21, %r2, 64;
    mul.lo.u32      %r14, %r10, 272;
    shl.b32         %r15, %r11, 1;
    add.u32         %r14, %r14, %r15;
    add.u32         %r18, %r9, %r14;
    add.u32         %r18, %r18, 10240;
    add.u32         %r19, %r18, 4352;
bcopyd:

    // tile 0 into stage 0, then point at tile 1
    cp.async.cg.shared.global [%r16], [%rd5], 16;
    cp.async.cg.shared.global [%r17], [%rd7], 16;
    cp.async.cg.shared.global [%r18], [%rd8], 16;
    cp.async.cg.shared.global [%r19], [%rd9], 16;
    cp.async.commit_group;
    add.u64         %rd5, %rd5, %rd20;
    add.u64         %rd7, %rd7, %rd20;
    add.u64         %rd8, %rd8, %rd21;
    add.u64         %rd9, %rd9, %rd21;

    // ldmatrix addresses in stage 0 (lA r27, lB r30), and how far apart the
    // fragments are: next mi (r50) and k 16..31 (r51) for A, next n pair (r52)
    // and k 16..31 (r53) for B. warp (wm, wn) = (warp/4, warp%4)
    shr.u32         %r22, %r5, 2;               // wm
    and.b32         %r23, %r5, 3;               // wn
    and.b32         %r40, %r6, 7;               // lane%8
    shr.u32         %r41, %r6, 3;
    and.b32         %r41, %r41, 1;              // (lane/8)%2
    shr.u32         %r42, %r6, 4;               // lane/16
    @%pta bra       lat;
    // A: row wm*64 + lane%16, col (lane/16)*8
    and.b32         %r24, %r6, 15;
    shl.b32         %r25, %r22, 6;
    add.u32         %r24, %r24, %r25;
    mul.lo.u32      %r24, %r24, 80;
    shl.b32         %r26, %r42, 4;
    add.u32         %r24, %r24, %r26;
    add.u32         %r27, %r9, %r24;
    mov.u32         %r50, 1280;
    mov.u32         %r51, 32;
    bra             lad;
lat:
    // A^T: k row lane%8 + (lane/16)*8, m col wm*64 + ((lane/8)%2)*8
    shl.b32         %r24, %r42, 3;
    add.u32         %r24, %r24, %r40;
    mul.lo.u32      %r24, %r24, 272;
    shl.b32         %r25, %r22, 6;
    shl.b32         %r26, %r41, 3;
    add.u32         %r25, %r25, %r26;
    shl.b32         %r25, %r25, 1;
    add.u32         %r24, %r24, %r25;
    add.u32         %r27, %r9, %r24;
    mov.u32         %r50, 32;
    mov.u32         %r51, 4352;
lad:
    @%ptb bra       lbt;
    // B: n row wn*32 + lane%8 + (lane/16)*8, k col ((lane/8)%2)*8
    shl.b32         %r28, %r42, 3;
    add.u32         %r28, %r28, %r40;
    shl.b32         %r29, %r23, 5;
    add.u32         %r28, %r28, %r29;
    mul.lo.u32      %r28, %r28, 80;
    shl.b32         %r29, %r41, 4;
    add.u32         %r28, %r28, %r29;
    add.u32         %r28, %r28, 10240;
    add.u32         %r30, %r9, %r28;
    mov.u32         %r52, 1280;
    mov.u32         %r53, 32;
    bra             lbd;
lbt:
    // B^T: k row lane%8 + ((lane/8)%2)*8, n col wn*32 + (lane/16)*8
    shl.b32         %r28, %r41, 3;
    add.u32         %r28, %r28, %r40;
    mul.lo.u32      %r28, %r28, 272;
    shl.b32         %r29, %r23, 5;
    shl.b32         %r31, %r42, 3;
    add.u32         %r29, %r29, %r31;
    shl.b32         %r29, %r29, 1;
    add.u32         %r28, %r28, %r29;
    add.u32         %r28, %r28, 10240;
    add.u32         %r30, %r9, %r28;
    mov.u32         %r52, 32;
    mov.u32         %r53, 4352;
lbd:

    // where this thread's part of C is: rows bm + wm*64 + 16mi + g (and +8),
    // cols bn + wn*32 + 8ni + 2t. r45 = row*N + col
    shr.u32         %r38, %r6, 2;               // g
    and.b32         %r39, %r6, 3;
    shl.b32         %r39, %r39, 1;              // 2t
    shl.b32         %r43, %r22, 6;
    add.u32         %r43, %r43, %r7;
    add.u32         %r43, %r43, %r38;
    shl.b32         %r44, %r23, 5;
    add.u32         %r44, %r44, %r8;
    add.u32         %r44, %r44, %r39;
    mad.lo.u32      %r45, %r43, %r2, %r44;
    cvt.u64.u32     %rd14, %r2;

    @%pr bra        initr;
    mov.f32 %f0, 0f00000000;   mov.f32 %f1, 0f00000000;   mov.f32 %f2, 0f00000000;   mov.f32 %f3, 0f00000000;
    mov.f32 %f4, 0f00000000;   mov.f32 %f5, 0f00000000;   mov.f32 %f6, 0f00000000;   mov.f32 %f7, 0f00000000;
    mov.f32 %f8, 0f00000000;   mov.f32 %f9, 0f00000000;   mov.f32 %f10, 0f00000000;  mov.f32 %f11, 0f00000000;
    mov.f32 %f12, 0f00000000;  mov.f32 %f13, 0f00000000;  mov.f32 %f14, 0f00000000;  mov.f32 %f15, 0f00000000;
    mov.f32 %f16, 0f00000000;  mov.f32 %f17, 0f00000000;  mov.f32 %f18, 0f00000000;  mov.f32 %f19, 0f00000000;
    mov.f32 %f20, 0f00000000;  mov.f32 %f21, 0f00000000;  mov.f32 %f22, 0f00000000;  mov.f32 %f23, 0f00000000;
    mov.f32 %f24, 0f00000000;  mov.f32 %f25, 0f00000000;  mov.f32 %f26, 0f00000000;  mov.f32 %f27, 0f00000000;
    mov.f32 %f28, 0f00000000;  mov.f32 %f29, 0f00000000;  mov.f32 %f30, 0f00000000;  mov.f32 %f31, 0f00000000;
    mov.f32 %f32, 0f00000000;  mov.f32 %f33, 0f00000000;  mov.f32 %f34, 0f00000000;  mov.f32 %f35, 0f00000000;
    mov.f32 %f36, 0f00000000;  mov.f32 %f37, 0f00000000;  mov.f32 %f38, 0f00000000;  mov.f32 %f39, 0f00000000;
    mov.f32 %f40, 0f00000000;  mov.f32 %f41, 0f00000000;  mov.f32 %f42, 0f00000000;  mov.f32 %f43, 0f00000000;
    mov.f32 %f44, 0f00000000;  mov.f32 %f45, 0f00000000;  mov.f32 %f46, 0f00000000;  mov.f32 %f47, 0f00000000;
    mov.f32 %f48, 0f00000000;  mov.f32 %f49, 0f00000000;  mov.f32 %f50, 0f00000000;  mov.f32 %f51, 0f00000000;
    mov.f32 %f52, 0f00000000;  mov.f32 %f53, 0f00000000;  mov.f32 %f54, 0f00000000;  mov.f32 %f55, 0f00000000;
    mov.f32 %f56, 0f00000000;  mov.f32 %f57, 0f00000000;  mov.f32 %f58, 0f00000000;  mov.f32 %f59, 0f00000000;
    mov.f32 %f60, 0f00000000;  mov.f32 %f61, 0f00000000;  mov.f32 %f62, 0f00000000;  mov.f32 %f63, 0f00000000;
    bra             kstart;
initr:
    mul.wide.u32    %rd12, %r45, 4;
    add.u64         %rd13, %rd30, %rd12;        // R, row g
    shl.b64         %rd15, %rd14, 5;            // 8 rows of f32
    shl.b64         %rd16, %rd14, 6;            // 16 rows
    add.u64         %rd17, %rd13, %rd15;        // row g+8
    ld.global.v2.f32 {%f0, %f1}, [%rd13];
    ld.global.v2.f32 {%f2, %f3}, [%rd17];
    ld.global.v2.f32 {%f4, %f5}, [%rd13+32];
    ld.global.v2.f32 {%f6, %f7}, [%rd17+32];
    ld.global.v2.f32 {%f8, %f9}, [%rd13+64];
    ld.global.v2.f32 {%f10, %f11}, [%rd17+64];
