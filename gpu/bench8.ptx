// fp8 versions of mma_peak (bench.ptx): e4m3 in, fp32 or fp16 accumulate. each
// mma.m16n8k32 is 2*16*8*32 = 8192 flops per warp. the inputs are around 2^-6 so
// the fp16 sums stay finite over the whole run
.visible .entry mma_e4m3(
    .param .u64 pout,
    .param .u32 piters,
    .param .u64 pclk)
{
    .reg .pred  %p;
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;
    .reg .f32   %f<40>;

    ld.param.u64    %rd1, [pout];
    ld.param.u32    %r1, [piters];
    mov.u64         %rd4, %clock64;
    mov.u64         %rd7, %globaltimer;
    mov.u32         %r2, %tid.x;
    and.b32         %r3, %r2, 7;
    add.u32         %r3, %r3, 0x08080808;
    add.u32         %r4, %r3, 0x01010101;
    add.u32         %r5, %r3, 0x02020202;
    add.u32         %r6, %r3, 0x03030303;
    add.u32         %r7, %r3, 0x04040404;
    add.u32         %r8, %r3, 0x05050505;
    mov.f32 %f0, 0f00000000;   mov.f32 %f1, 0f00000000;   mov.f32 %f2, 0f00000000;   mov.f32 %f3, 0f00000000;
    mov.f32 %f4, 0f00000000;   mov.f32 %f5, 0f00000000;   mov.f32 %f6, 0f00000000;   mov.f32 %f7, 0f00000000;
    mov.f32 %f8, 0f00000000;   mov.f32 %f9, 0f00000000;   mov.f32 %f10, 0f00000000;  mov.f32 %f11, 0f00000000;
    mov.f32 %f12, 0f00000000;  mov.f32 %f13, 0f00000000;  mov.f32 %f14, 0f00000000;  mov.f32 %f15, 0f00000000;
    mov.f32 %f16, 0f00000000;  mov.f32 %f17, 0f00000000;  mov.f32 %f18, 0f00000000;  mov.f32 %f19, 0f00000000;
    mov.f32 %f20, 0f00000000;  mov.f32 %f21, 0f00000000;  mov.f32 %f22, 0f00000000;  mov.f32 %f23, 0f00000000;
    mov.f32 %f24, 0f00000000;  mov.f32 %f25, 0f00000000;  mov.f32 %f26, 0f00000000;  mov.f32 %f27, 0f00000000;
    mov.f32 %f28, 0f00000000;  mov.f32 %f29, 0f00000000;  mov.f32 %f30, 0f00000000;  mov.f32 %f31, 0f00000000;
    mov.u32         %r9, 0;
loop:
    mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%f0, %f1, %f2, %f3}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%f0, %f1, %f2, %f3};
    mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%f4, %f5, %f6, %f7}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%f4, %f5, %f6, %f7};
    mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%f8, %f9, %f10, %f11}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%f8, %f9, %f10, %f11};
    mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%f12, %f13, %f14, %f15}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%f12, %f13, %f14, %f15};
    mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%f16, %f17, %f18, %f19}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%f16, %f17, %f18, %f19};
    mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%f20, %f21, %f22, %f23}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%f20, %f21, %f22, %f23};
    mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%f24, %f25, %f26, %f27}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%f24, %f25, %f26, %f27};
    mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%f28, %f29, %f30, %f31}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%f28, %f29, %f30, %f31};
    add.u32         %r9, %r9, 1;
    setp.lt.u32     %p, %r9, %r1;
    @%p bra         loop;
    mov.u64         %rd5, %clock64;
    sub.u64         %rd5, %rd5, %rd4;
    mov.u64         %rd4, %globaltimer;
    sub.u64         %rd7, %rd4, %rd7;
    mov.u32         %r13, %ctaid.x;
    or.b32          %r13, %r13, %r2;
    setp.ne.u32     %p, %r13, 0;
    @%p bra         sum;
    ld.param.u64    %rd6, [pclk];
    st.global.u64   [%rd6], %rd5;
    st.global.u64   [%rd6+8], %rd7;
sum:
    add.f32 %f32, %f0, %f4;    add.f32 %f33, %f8, %f12;   add.f32 %f34, %f16, %f20;  add.f32 %f35, %f24, %f28;
    add.f32 %f32, %f32, %f1;   add.f32 %f33, %f33, %f9;   add.f32 %f34, %f34, %f17;  add.f32 %f35, %f35, %f25;
    add.f32 %f32, %f32, %f33;
    add.f32 %f34, %f34, %f35;
    add.f32 %f36, %f32, %f34;
    mov.u32         %r10, %ctaid.x;
    mov.u32         %r11, %ntid.x;
    mad.lo.u32      %r12, %r10, %r11, %r2;
    mul.wide.u32    %rd2, %r12, 4;
    add.u64         %rd3, %rd1, %rd2;
    st.global.f32   [%rd3], %f36;
    ret;
}

// the same with fp16 accumulators: two f16x2 registers per chain instead of four f32
.visible .entry mma_e4m3h(
    .param .u64 pout,
    .param .u32 piters,
    .param .u64 pclk)
{
    .reg .pred  %p;
    .reg .b32   %r<16>;
    .reg .b32   %h<20>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pout];
    ld.param.u32    %r1, [piters];
    mov.u64         %rd4, %clock64;
    mov.u64         %rd7, %globaltimer;
    mov.u32         %r2, %tid.x;
    and.b32         %r3, %r2, 7;
    add.u32         %r3, %r3, 0x08080808;
    add.u32         %r4, %r3, 0x01010101;
    add.u32         %r5, %r3, 0x02020202;
    add.u32         %r6, %r3, 0x03030303;
    add.u32         %r7, %r3, 0x04040404;
    add.u32         %r8, %r3, 0x05050505;
    mov.b32 %h0, 0;   mov.b32 %h1, 0;   mov.b32 %h2, 0;   mov.b32 %h3, 0;
    mov.b32 %h4, 0;   mov.b32 %h5, 0;   mov.b32 %h6, 0;   mov.b32 %h7, 0;
    mov.b32 %h8, 0;   mov.b32 %h9, 0;   mov.b32 %h10, 0;  mov.b32 %h11, 0;
    mov.b32 %h12, 0;  mov.b32 %h13, 0;  mov.b32 %h14, 0;  mov.b32 %h15, 0;
    mov.u32         %r9, 0;
loop:
    mma.sync.aligned.m16n8k32.row.col.f16.e4m3.e4m3.f16 {%h0, %h1}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%h0, %h1};
    mma.sync.aligned.m16n8k32.row.col.f16.e4m3.e4m3.f16 {%h2, %h3}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%h2, %h3};
    mma.sync.aligned.m16n8k32.row.col.f16.e4m3.e4m3.f16 {%h4, %h5}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%h4, %h5};
    mma.sync.aligned.m16n8k32.row.col.f16.e4m3.e4m3.f16 {%h6, %h7}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%h6, %h7};
    mma.sync.aligned.m16n8k32.row.col.f16.e4m3.e4m3.f16 {%h8, %h9}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%h8, %h9};
    mma.sync.aligned.m16n8k32.row.col.f16.e4m3.e4m3.f16 {%h10, %h11}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%h10, %h11};
    mma.sync.aligned.m16n8k32.row.col.f16.e4m3.e4m3.f16 {%h12, %h13}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%h12, %h13};
    mma.sync.aligned.m16n8k32.row.col.f16.e4m3.e4m3.f16 {%h14, %h15}, {%r3, %r4, %r5, %r6}, {%r7, %r8}, {%h14, %h15};
    add.u32         %r9, %r9, 1;
    setp.lt.u32     %p, %r9, %r1;
    @%p bra         loop;
    mov.u64         %rd5, %clock64;
    sub.u64         %rd5, %rd5, %rd4;
    mov.u64         %rd4, %globaltimer;
    sub.u64         %rd7, %rd4, %rd7;
    mov.u32         %r13, %ctaid.x;
    or.b32          %r13, %r13, %r2;
    setp.ne.u32     %p, %r13, 0;
    @%p bra         sum;
    ld.param.u64    %rd6, [pclk];
    st.global.u64   [%rd6], %rd5;
    st.global.u64   [%rd6+8], %rd7;
sum:
    xor.b32 %h16, %h0, %h2;    xor.b32 %h17, %h4, %h6;    xor.b32 %h18, %h8, %h10;   xor.b32 %h19, %h12, %h14;
    xor.b32 %h16, %h16, %h1;   xor.b32 %h17, %h17, %h5;   xor.b32 %h18, %h18, %h9;   xor.b32 %h19, %h19, %h13;
    xor.b32 %h16, %h16, %h3;   xor.b32 %h17, %h17, %h7;   xor.b32 %h18, %h18, %h11;  xor.b32 %h19, %h19, %h15;
    xor.b32 %h16, %h16, %h17;
    xor.b32 %h18, %h18, %h19;
    xor.b32 %h16, %h16, %h18;
    mov.u32         %r10, %ctaid.x;
    mov.u32         %r11, %ntid.x;
    mad.lo.u32      %r12, %r10, %r11, %r2;
    mul.wide.u32    %rd2, %r12, 4;
    add.u64         %rd3, %rd1, %rd2;
    st.global.b32   [%rd3], %h16;
    ret;
}
