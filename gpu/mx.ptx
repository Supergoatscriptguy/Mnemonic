// mxfp8: block-scaled fp8 matmuls. values are e4m3, with one ue8m0 scale (a power
// of two, 2^(s-127)) per 32 of them along k. the mma needs sm_120a (gpu_arch)

// which lane and byte of the scale registers feeds which row of A / column of B.
// every value is 1.0 and every scale byte is different, 1 + 4*lane + byte, so each
// C = 32 * 2^(that - 127) says where its scale came from. one warp, C is 16x8 f32
.visible .entry mx_probe(
    .param .u64 pc,
    .param .u32 pwhich,
    .param .u32 pbyte,
    .param .u32 pthread)
{
    .reg .pred  %p;
    .reg .b16   %sb, %st;
    .reg .b32   %r<16>;
    .reg .b64   %rd<4>;
    .reg .f32   %f<4>;

    ld.param.u32    %r1, [pwhich];              // 0: A's scales vary, 1: B's
    ld.param.u32    %r2, [pbyte];
    ld.param.u32    %r3, [pthread];
    cvt.u16.u32     %sb, %r2;
    cvt.u16.u32     %st, %r3;
    mov.u32         %r4, %tid.x;
    shl.b32         %r5, %r4, 2;
    add.u32         %r5, %r5, 1;
    mul.lo.u32      %r6, %r5, 0x01010101;
    add.u32         %r6, %r6, 0x03020100;
    mov.b32         %r7, 0x7f7f7f7f;            // 1.0
    setp.eq.u32     %p, %r1, 0;
    selp.b32        %r8, %r6, %r7, %p;
    selp.b32        %r9, %r7, %r6, %p;
    mov.b32         %r10, 0x38383838;           // e4m3 1.0
    mov.f32         %f0, 0f00000000;
    mov.f32         %f1, 0f00000000;
    mov.f32         %f2, 0f00000000;
    mov.f32         %f3, 0f00000000;
    mma.sync.aligned.kind::mxf8f6f4.block_scale.scale_vec::1X.m16n8k32.row.col.f32.e4m3.e4m3.f32.ue8m0 {%f0, %f1, %f2, %f3}, {%r10, %r10, %r10, %r10}, {%r10, %r10}, {%f0, %f1, %f2, %f3}, {%r8}, {%sb, %st}, {%r9}, {%sb, %st};
    // c0 c1 are row g, columns 2t and 2t+1, c2 c3 the same in row g+8
    shr.u32         %r11, %r4, 2;
    and.b32         %r12, %r4, 3;
    shl.b32         %r12, %r12, 1;
    mad.lo.u32      %r13, %r11, 8, %r12;
    ld.param.u64    %rd1, [pc];
    mul.wide.u32    %rd2, %r13, 4;
    add.u64         %rd1, %rd1, %rd2;
    st.global.v2.f32 [%rd1], {%f0, %f1};
    st.global.v2.f32 [%rd1+256], {%f2, %f3};
    ret;
}

// x (bf16, or f32 with flag 8) -> q (e4m3) and s (a ue8m0 per 32 values). blocks
// run along the rows, so block i is x[32i..32i+31] -> q[32i..], s[i]. the scale is
// the smallest power of two that gets the block's max inside e4m3's +-448, so
// nothing saturates. an all-zero block gets 1.0. one thread per block, grid stride
.visible .entry mxq(
    .param .u64 px,
    .param .u64 pq,
    .param .u64 ps,
    .param .u32 pn,
    .param .u32 pf)
{
    .reg .pred  %p, %pw;
    .reg .b32   %r<16>;
    .reg .b32   %w<16>;
    .reg .b64   %rd<8>;
    .reg .f32   %x<32>;
    .reg .f32   %f<4>;
    .reg .b16   %h<16>;

    ld.param.u32    %r1, [pn];
    ld.param.u32    %r2, [pf];
    and.b32         %r2, %r2, 8;
    setp.ne.u32     %pw, %r2, 0;
    mov.u32         %r3, %ctaid.x;
    mov.u32         %r4, %ntid.x;
    mov.u32         %r5, %tid.x;
    mad.lo.u32      %r6, %r3, %r4, %r5;
    mov.u32         %r7, %nctaid.x;
    mul.lo.u32      %r7, %r7, %r4;
blk:
    setp.ge.u32     %p, %r6, %r1;
    @%p bra         done;
    ld.param.u64    %rd1, [px];
    @%pw bra        wide;
    mul.wide.u32    %rd2, %r6, 64;
    add.u64         %rd1, %rd1, %rd2;
    ld.global.v4.b32 {%w0, %w1, %w2, %w3}, [%rd1];
    ld.global.v4.b32 {%w4, %w5, %w6, %w7}, [%rd1+16];
    ld.global.v4.b32 {%w8, %w9, %w10, %w11}, [%rd1+32];
    ld.global.v4.b32 {%w12, %w13, %w14, %w15}, [%rd1+48];
    // a bf16 is the top half of an f32, and the first of a pair is the low half
    shl.b32 %r8, %w0, 16;   mov.b32 %x0, %r8;   and.b32 %r8, %w0, 0xffff0000;   mov.b32 %x1, %r8;
    shl.b32 %r8, %w1, 16;   mov.b32 %x2, %r8;   and.b32 %r8, %w1, 0xffff0000;   mov.b32 %x3, %r8;
    shl.b32 %r8, %w2, 16;   mov.b32 %x4, %r8;   and.b32 %r8, %w2, 0xffff0000;   mov.b32 %x5, %r8;
    shl.b32 %r8, %w3, 16;   mov.b32 %x6, %r8;   and.b32 %r8, %w3, 0xffff0000;   mov.b32 %x7, %r8;
    shl.b32 %r8, %w4, 16;   mov.b32 %x8, %r8;   and.b32 %r8, %w4, 0xffff0000;   mov.b32 %x9, %r8;
    shl.b32 %r8, %w5, 16;   mov.b32 %x10, %r8;  and.b32 %r8, %w5, 0xffff0000;   mov.b32 %x11, %r8;
    shl.b32 %r8, %w6, 16;   mov.b32 %x12, %r8;  and.b32 %r8, %w6, 0xffff0000;   mov.b32 %x13, %r8;
    shl.b32 %r8, %w7, 16;   mov.b32 %x14, %r8;  and.b32 %r8, %w7, 0xffff0000;   mov.b32 %x15, %r8;
    shl.b32 %r8, %w8, 16;   mov.b32 %x16, %r8;  and.b32 %r8, %w8, 0xffff0000;   mov.b32 %x17, %r8;
    shl.b32 %r8, %w9, 16;   mov.b32 %x18, %r8;  and.b32 %r8, %w9, 0xffff0000;   mov.b32 %x19, %r8;
    shl.b32 %r8, %w10, 16;  mov.b32 %x20, %r8;  and.b32 %r8, %w10, 0xffff0000;  mov.b32 %x21, %r8;
    shl.b32 %r8, %w11, 16;  mov.b32 %x22, %r8;  and.b32 %r8, %w11, 0xffff0000;  mov.b32 %x23, %r8;
    shl.b32 %r8, %w12, 16;  mov.b32 %x24, %r8;  and.b32 %r8, %w12, 0xffff0000;  mov.b32 %x25, %r8;
    shl.b32 %r8, %w13, 16;  mov.b32 %x26, %r8;  and.b32 %r8, %w13, 0xffff0000;  mov.b32 %x27, %r8;
    shl.b32 %r8, %w14, 16;  mov.b32 %x28, %r8;  and.b32 %r8, %w14, 0xffff0000;  mov.b32 %x29, %r8;
    shl.b32 %r8, %w15, 16;  mov.b32 %x30, %r8;  and.b32 %r8, %w15, 0xffff0000;  mov.b32 %x31, %r8;
    bra             scale;
wide:
    mul.wide.u32    %rd2, %r6, 128;
    add.u64         %rd1, %rd1, %rd2;
    ld.global.v4.f32 {%x0, %x1, %x2, %x3}, [%rd1];
    ld.global.v4.f32 {%x4, %x5, %x6, %x7}, [%rd1+16];
    ld.global.v4.f32 {%x8, %x9, %x10, %x11}, [%rd1+32];
    ld.global.v4.f32 {%x12, %x13, %x14, %x15}, [%rd1+48];
    ld.global.v4.f32 {%x16, %x17, %x18, %x19}, [%rd1+64];
    ld.global.v4.f32 {%x20, %x21, %x22, %x23}, [%rd1+80];
    ld.global.v4.f32 {%x24, %x25, %x26, %x27}, [%rd1+96];
    ld.global.v4.f32 {%x28, %x29, %x30, %x31}, [%rd1+112];
scale:
    abs.f32 %f0, %x0;
    abs.f32 %f1, %x1;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x2;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x3;   max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x4;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x5;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x6;   max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x7;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x8;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x9;   max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x10;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x11;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x12;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x13;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x14;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x15;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x16;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x17;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x18;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x19;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x20;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x21;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x22;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x23;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x24;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x25;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x26;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x27;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x28;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x29;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x30;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x31;  max.f32 %f0, %f0, %f1;
    // max = m * 2^e with m in [1, 2), and 448 = 1.75 * 2^8: the scale is 2^(e-8),
    // or 2^(e-7) when m > 1.75. s is that exponent + 127
    mov.b32         %r9, %f0;
    shr.u32         %r10, %r9, 23;
    and.b32         %r11, %r9, 0x7fffff;
    setp.gt.u32     %p, %r11, 0x600000;
    selp.u32        %r11, 1, 0, %p;
    add.u32         %r10, %r10, %r11;
    sub.s32         %r10, %r10, 8;
    max.s32         %r10, %r10, 1;
    min.s32         %r10, %r10, 253;
    setp.eq.u32     %p, %r9, 0;
    selp.u32        %r10, 127, %r10, %p;
    mov.u32         %r12, 254;
    sub.u32         %r12, %r12, %r10;
    shl.b32         %r12, %r12, 23;
    mov.b32         %f1, %r12;                  // 1 / scale, exactly
    mul.f32 %x0, %x0, %f1;    mul.f32 %x1, %x1, %f1;    mul.f32 %x2, %x2, %f1;    mul.f32 %x3, %x3, %f1;
    mul.f32 %x4, %x4, %f1;    mul.f32 %x5, %x5, %f1;    mul.f32 %x6, %x6, %f1;    mul.f32 %x7, %x7, %f1;
    mul.f32 %x8, %x8, %f1;    mul.f32 %x9, %x9, %f1;    mul.f32 %x10, %x10, %f1;  mul.f32 %x11, %x11, %f1;
    mul.f32 %x12, %x12, %f1;  mul.f32 %x13, %x13, %f1;  mul.f32 %x14, %x14, %f1;  mul.f32 %x15, %x15, %f1;
    mul.f32 %x16, %x16, %f1;  mul.f32 %x17, %x17, %f1;  mul.f32 %x18, %x18, %f1;  mul.f32 %x19, %x19, %f1;
    mul.f32 %x20, %x20, %f1;  mul.f32 %x21, %x21, %f1;  mul.f32 %x22, %x22, %f1;  mul.f32 %x23, %x23, %f1;
    mul.f32 %x24, %x24, %f1;  mul.f32 %x25, %x25, %f1;  mul.f32 %x26, %x26, %f1;  mul.f32 %x27, %x27, %f1;
    mul.f32 %x28, %x28, %f1;  mul.f32 %x29, %x29, %f1;  mul.f32 %x30, %x30, %f1;  mul.f32 %x31, %x31, %f1;
    // the first operand goes in the high byte
    cvt.rn.satfinite.e4m3x2.f32 %h0, %x1, %x0;      cvt.rn.satfinite.e4m3x2.f32 %h1, %x3, %x2;
    cvt.rn.satfinite.e4m3x2.f32 %h2, %x5, %x4;      cvt.rn.satfinite.e4m3x2.f32 %h3, %x7, %x6;
    cvt.rn.satfinite.e4m3x2.f32 %h4, %x9, %x8;      cvt.rn.satfinite.e4m3x2.f32 %h5, %x11, %x10;
    cvt.rn.satfinite.e4m3x2.f32 %h6, %x13, %x12;    cvt.rn.satfinite.e4m3x2.f32 %h7, %x15, %x14;
    cvt.rn.satfinite.e4m3x2.f32 %h8, %x17, %x16;    cvt.rn.satfinite.e4m3x2.f32 %h9, %x19, %x18;
    cvt.rn.satfinite.e4m3x2.f32 %h10, %x21, %x20;   cvt.rn.satfinite.e4m3x2.f32 %h11, %x23, %x22;
    cvt.rn.satfinite.e4m3x2.f32 %h12, %x25, %x24;   cvt.rn.satfinite.e4m3x2.f32 %h13, %x27, %x26;
    cvt.rn.satfinite.e4m3x2.f32 %h14, %x29, %x28;   cvt.rn.satfinite.e4m3x2.f32 %h15, %x31, %x30;
    mov.b32 %w0, {%h0, %h1};    mov.b32 %w1, {%h2, %h3};    mov.b32 %w2, {%h4, %h5};    mov.b32 %w3, {%h6, %h7};
    mov.b32 %w4, {%h8, %h9};    mov.b32 %w5, {%h10, %h11};  mov.b32 %w6, {%h12, %h13};  mov.b32 %w7, {%h14, %h15};
    ld.param.u64    %rd3, [pq];
    mul.wide.u32    %rd4, %r6, 32;
    add.u64         %rd3, %rd3, %rd4;
    st.global.v4.b32 [%rd3], {%w0, %w1, %w2, %w3};
    st.global.v4.b32 [%rd3+16], {%w4, %w5, %w6, %w7};
    ld.param.u64    %rd5, [ps];
    cvt.u64.u32     %rd6, %r6;
    add.u64         %rd5, %rd5, %rd6;
    st.global.u8    [%rd5], %r10;
    add.u32         %r6, %r6, %r7;
    bra             blk;
done:
    ret;
}

// mxq for the other way round: x [rows][cols] (bf16, or f32 with flag 8) -> q
// [cols][rows] and s [cols][rows/32], blocks of 32 going down a column. that's what
// a matmul needs when its k is x's rows (the tokens, for weight gradients) or for a
// transposed weight. thread i does column i%cols of row block i/cols, so a warp
// loads side by side. rows a multiple of 32, grid stride
.visible .entry mxqt(
    .param .u64 px,
    .param .u64 pq,
    .param .u64 ps,
    .param .u32 prows,
    .param .u32 pcols,
    .param .u32 pf)
{
    .reg .pred  %p, %pw;
    .reg .b32   %r<24>;
    .reg .b32   %w<8>;
    .reg .b64   %rd<12>;
    .reg .f32   %x<32>;
    .reg .f32   %f<4>;
    .reg .b16   %h<16>;

    ld.param.u32    %r1, [prows];
    ld.param.u32    %r2, [pcols];
    ld.param.u32    %r3, [pf];
    and.b32         %r3, %r3, 8;
    setp.ne.u32     %pw, %r3, 0;
    shr.u32         %r4, %r1, 5;                // row blocks
    mul.lo.u32      %r5, %r4, %r2;              // blocks
    mov.u32         %r6, %ctaid.x;
    mov.u32         %r7, %ntid.x;
    mov.u32         %r8, %tid.x;
    mad.lo.u32      %r9, %r6, %r7, %r8;
    mov.u32         %r10, %nctaid.x;
    mul.lo.u32      %r10, %r10, %r7;
    selp.u32        %r11, 4, 2, %pw;            // element size
    mul.wide.u32    %rd1, %r2, %r11;            // a row in bytes
blk:
    setp.ge.u32     %p, %r9, %r5;
    @%p bra         done;
    rem.u32         %r12, %r9, %r2;             // column
    div.u32         %r13, %r9, %r2;             // row block
    shl.b32         %r14, %r13, 5;
    mul.wide.u32    %rd2, %r14, %r2;
    cvt.u64.u32     %rd3, %r12;
    add.u64         %rd2, %rd2, %rd3;
    cvt.u64.u32     %rd3, %r11;
    mul.lo.u64      %rd2, %rd2, %rd3;
    ld.param.u64    %rd4, [px];
    add.u64         %rd4, %rd4, %rd2;           // x[rb*32][c]
    @%pw bra        wide;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x0, %r15;   add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x1, %r15;   add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x2, %r15;   add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x3, %r15;   add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x4, %r15;   add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x5, %r15;   add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x6, %r15;   add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x7, %r15;   add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x8, %r15;   add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x9, %r15;   add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x10, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x11, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x12, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x13, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x14, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x15, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x16, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x17, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x18, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x19, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x20, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x21, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x22, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x23, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x24, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x25, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x26, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x27, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x28, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x29, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x30, %r15;  add.u64 %rd4, %rd4, %rd1;
    ld.global.u16 %r15, [%rd4];  shl.b32 %r15, %r15, 16;  mov.b32 %x31, %r15;
    bra             scale;
wide:
    ld.global.f32 %x0, [%rd4];   add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x1, [%rd4];   add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x2, [%rd4];   add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x3, [%rd4];   add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x4, [%rd4];   add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x5, [%rd4];   add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x6, [%rd4];   add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x7, [%rd4];   add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x8, [%rd4];   add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x9, [%rd4];   add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x10, [%rd4];  add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x11, [%rd4];  add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x12, [%rd4];  add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x13, [%rd4];  add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x14, [%rd4];  add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x15, [%rd4];  add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x16, [%rd4];  add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x17, [%rd4];  add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x18, [%rd4];  add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x19, [%rd4];  add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x20, [%rd4];  add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x21, [%rd4];  add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x22, [%rd4];  add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x23, [%rd4];  add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x24, [%rd4];  add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x25, [%rd4];  add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x26, [%rd4];  add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x27, [%rd4];  add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x28, [%rd4];  add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x29, [%rd4];  add.u64 %rd4, %rd4, %rd1;
    ld.global.f32 %x30, [%rd4];  add.u64 %rd4, %rd4, %rd1;   ld.global.f32 %x31, [%rd4];
scale:
    // from here it's mxq's
    abs.f32 %f0, %x0;
    abs.f32 %f1, %x1;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x2;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x3;   max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x4;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x5;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x6;   max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x7;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x8;   max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x9;   max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x10;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x11;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x12;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x13;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x14;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x15;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x16;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x17;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x18;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x19;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x20;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x21;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x22;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x23;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x24;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x25;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x26;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x27;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x28;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x29;  max.f32 %f0, %f0, %f1;   abs.f32 %f1, %x30;  max.f32 %f0, %f0, %f1;
    abs.f32 %f1, %x31;  max.f32 %f0, %f0, %f1;
    mov.b32         %r16, %f0;
    shr.u32         %r17, %r16, 23;
    and.b32         %r18, %r16, 0x7fffff;
    setp.gt.u32     %p, %r18, 0x600000;
    selp.u32        %r18, 1, 0, %p;
    add.u32         %r17, %r17, %r18;
    sub.s32         %r17, %r17, 8;
    max.s32         %r17, %r17, 1;
    min.s32         %r17, %r17, 253;
    setp.eq.u32     %p, %r16, 0;
    selp.u32        %r17, 127, %r17, %p;
    mov.u32         %r19, 254;
    sub.u32         %r19, %r19, %r17;
    shl.b32         %r19, %r19, 23;
    mov.b32         %f1, %r19;
    mul.f32 %x0, %x0, %f1;    mul.f32 %x1, %x1, %f1;    mul.f32 %x2, %x2, %f1;    mul.f32 %x3, %x3, %f1;
    mul.f32 %x4, %x4, %f1;    mul.f32 %x5, %x5, %f1;    mul.f32 %x6, %x6, %f1;    mul.f32 %x7, %x7, %f1;
    mul.f32 %x8, %x8, %f1;    mul.f32 %x9, %x9, %f1;    mul.f32 %x10, %x10, %f1;  mul.f32 %x11, %x11, %f1;
    mul.f32 %x12, %x12, %f1;  mul.f32 %x13, %x13, %f1;  mul.f32 %x14, %x14, %f1;  mul.f32 %x15, %x15, %f1;
    mul.f32 %x16, %x16, %f1;  mul.f32 %x17, %x17, %f1;  mul.f32 %x18, %x18, %f1;  mul.f32 %x19, %x19, %f1;
    mul.f32 %x20, %x20, %f1;  mul.f32 %x21, %x21, %f1;  mul.f32 %x22, %x22, %f1;  mul.f32 %x23, %x23, %f1;
    mul.f32 %x24, %x24, %f1;  mul.f32 %x25, %x25, %f1;  mul.f32 %x26, %x26, %f1;  mul.f32 %x27, %x27, %f1;
    mul.f32 %x28, %x28, %f1;  mul.f32 %x29, %x29, %f1;  mul.f32 %x30, %x30, %f1;  mul.f32 %x31, %x31, %f1;
    cvt.rn.satfinite.e4m3x2.f32 %h0, %x1, %x0;      cvt.rn.satfinite.e4m3x2.f32 %h1, %x3, %x2;
    cvt.rn.satfinite.e4m3x2.f32 %h2, %x5, %x4;      cvt.rn.satfinite.e4m3x2.f32 %h3, %x7, %x6;
    cvt.rn.satfinite.e4m3x2.f32 %h4, %x9, %x8;      cvt.rn.satfinite.e4m3x2.f32 %h5, %x11, %x10;
    cvt.rn.satfinite.e4m3x2.f32 %h6, %x13, %x12;    cvt.rn.satfinite.e4m3x2.f32 %h7, %x15, %x14;
    cvt.rn.satfinite.e4m3x2.f32 %h8, %x17, %x16;    cvt.rn.satfinite.e4m3x2.f32 %h9, %x19, %x18;
    cvt.rn.satfinite.e4m3x2.f32 %h10, %x21, %x20;   cvt.rn.satfinite.e4m3x2.f32 %h11, %x23, %x22;
    cvt.rn.satfinite.e4m3x2.f32 %h12, %x25, %x24;   cvt.rn.satfinite.e4m3x2.f32 %h13, %x27, %x26;
    cvt.rn.satfinite.e4m3x2.f32 %h14, %x29, %x28;   cvt.rn.satfinite.e4m3x2.f32 %h15, %x31, %x30;
    mov.b32 %w0, {%h0, %h1};    mov.b32 %w1, {%h2, %h3};    mov.b32 %w2, {%h4, %h5};    mov.b32 %w3, {%h6, %h7};
    mov.b32 %w4, {%h8, %h9};    mov.b32 %w5, {%h10, %h11};  mov.b32 %w6, {%h12, %h13};  mov.b32 %w7, {%h14, %h15};
    // q[c][rb*32..], s[c][rb]
    mul.wide.u32    %rd5, %r12, %r1;
    cvt.u64.u32     %rd6, %r14;
    add.u64         %rd5, %rd5, %rd6;
    ld.param.u64    %rd7, [pq];
    add.u64         %rd7, %rd7, %rd5;
    st.global.v4.b32 [%rd7], {%w0, %w1, %w2, %w3};
    st.global.v4.b32 [%rd7+16], {%w4, %w5, %w6, %w7};
    mul.wide.u32    %rd8, %r12, %r4;
    cvt.u64.u32     %rd9, %r13;
    add.u64         %rd8, %rd8, %rd9;
    ld.param.u64    %rd10, [ps];
    add.u64         %rd10, %rd10, %rd8;
    st.global.u8    [%rd10], %r17;
    add.u32         %r9, %r9, %r10;
    bra             blk;
done:
    ret;
}

// the reference: C = R + A B^T where A = qa * 2^(sa-127) and B = qb * 2^(sb-127).
// every value gets decoded to f32 on its own (exact) and added up with a plain fma
// in k order. A is M x K, B is N x K, scales M x K/32 and N x K/32. flag 4: bf16 C.
// block 16x16, grid (N/16, M/16) rounded up, K a multiple of 32
.visible .entry mm_mx(
    .param .u64 pa,
    .param .u64 psa,
    .param .u64 pb,
    .param .u64 psb,
    .param .u64 pc,
    .param .u32 pm,
    .param .u32 pn,
    .param .u32 pk,
    .param .u64 pr,
    .param .u32 pf)
{
    .reg .pred  %p, %pbf;
    .reg .b32   %r<24>;
    .reg .b64   %rd<16>;
    .reg .f32   %f<8>;
    .reg .b16   %h<4>;

    ld.param.u32    %r1, [pm];
    ld.param.u32    %r2, [pn];
    ld.param.u32    %r3, [pk];
    ld.param.u32    %r4, [pf];
    and.b32         %r4, %r4, 4;
    setp.ne.u32     %pbf, %r4, 0;
    mov.u32         %r5, %ctaid.x;
    mov.u32         %r6, %tid.x;
    mad.lo.u32      %r7, %r5, 16, %r6;          // n
    mov.u32         %r5, %ctaid.y;
    mov.u32         %r6, %tid.y;
    mad.lo.u32      %r8, %r5, 16, %r6;          // m
    setp.ge.u32     %p, %r7, %r2;
    @%p bra         done;
    setp.ge.u32     %p, %r8, %r1;
    @%p bra         done;
    shr.u32         %r9, %r3, 5;                // scales a row
    ld.param.u64    %rd1, [pa];
    mul.wide.u32    %rd2, %r8, %r3;
    add.u64         %rd1, %rd1, %rd2;
    ld.param.u64    %rd3, [psa];
    mul.wide.u32    %rd2, %r8, %r9;
    add.u64         %rd3, %rd3, %rd2;
    ld.param.u64    %rd4, [pb];
    mul.wide.u32    %rd2, %r7, %r3;
    add.u64         %rd4, %rd4, %rd2;
    ld.param.u64    %rd5, [psb];
    mul.wide.u32    %rd2, %r7, %r9;
    add.u64         %rd5, %rd5, %rd2;
    mov.f32         %f1, 0f00000000;
    mov.u32         %r10, 0;
kloop:
    setp.ge.u32     %p, %r10, %r3;
    @%p bra         kdone;
    and.b32         %r11, %r10, 31;
    setp.ne.u32     %p, %r11, 0;
    @%p bra         val;
    // 2^(s-127) is s in the exponent field (s = 0 is the denormal 2^-127)
    ld.global.u8    %r12, [%rd3];
    ld.global.u8    %r13, [%rd5];
    add.u64         %rd3, %rd3, 1;
    add.u64         %rd5, %rd5, 1;
    shl.b32         %r14, %r12, 23;
    setp.eq.u32     %p, %r12, 0;
    selp.b32        %r14, 0x00400000, %r14, %p;
    mov.b32         %f2, %r14;
    shl.b32         %r14, %r13, 23;
    setp.eq.u32     %p, %r13, 0;
    selp.b32        %r14, 0x00400000, %r14, %p;
    mov.b32         %f3, %r14;
val:
    ld.global.u8    %r15, [%rd1];
    ld.global.u8    %r16, [%rd4];
    cvt.u16.u32     %h0, %r15;
    cvt.rn.f16x2.e4m3x2 %r17, %h0;              // our value is the low half
    mov.b32         {%h1, %h2}, %r17;
    cvt.f32.f16     %f4, %h1;
    cvt.u16.u32     %h0, %r16;
    cvt.rn.f16x2.e4m3x2 %r17, %h0;
    mov.b32         {%h1, %h2}, %r17;
    cvt.f32.f16     %f5, %h1;
    mul.f32         %f4, %f4, %f2;
    mul.f32         %f5, %f5, %f3;
    fma.rn.f32      %f1, %f4, %f5, %f1;
    add.u64         %rd1, %rd1, 1;
    add.u64         %rd4, %rd4, 1;
    add.u32         %r10, %r10, 1;
    bra             kloop;
kdone:
    mad.lo.u32      %r18, %r8, %r2, %r7;        // m*N + n
    mul.wide.u32    %rd7, %r18, 4;
    ld.param.u64    %rd8, [pr];
    setp.eq.u64     %p, %rd8, 0;
    @%p bra         store;
    add.u64         %rd8, %rd8, %rd7;
    ld.global.f32   %f6, [%rd8];
    add.f32         %f1, %f6, %f1;
store:
    ld.param.u64    %rd9, [pc];
    @%pbf bra       store16;
    add.u64         %rd9, %rd9, %rd7;
    st.global.f32   [%rd9], %f1;
    bra             done;
store16:
    mul.wide.u32    %rd10, %r18, 2;
    add.u64         %rd9, %rd9, %rd10;
    cvt.rn.bf16.f32 %h3, %f1;
    st.global.b16   [%rd9], %h3;
done:
    ret;
}

// the fast one: gemm_tc (gemm.ptx) for fp8. a block does 128x128 of C, going
// through K 64 at a time. that's 64 bytes a row, like gemm_tc's 32 bf16, and an
// m16n8k32 fp8 fragment has the same bytes as an m16n8k16 bf16 one, so the copies
// and ldmatrix are gemm_tc's. there are no transposed layouts: mx scales run along
// k, so every operand gets quantized k-major anyway.
// the scales come straight from global, three u16 loads a thread a k tile. the mma
// takes row r of an A tile from lane 4r (r+8 from 4r+1, thread-id 1 adds 2) and
// column j of a B tile from lane 4j + thread-id (see mx_probe), so lane 4g+t holds
//   A: row g + 8(t&1) of m tiles 2(t>>1) and 2(t>>1)+1, two k blocks each = 4 bytes,
//      byte (mi&1)*2 + k step, thread-id mi>>1
//   B: column g of n tile t, two k blocks: byte k step, thread-id ni
// flag 4: bf16 C. pr (f32, optional): C = R + A B^T. split k with grid z > 1 as in
// gemm_tc: block z writes its partial to C + z*M*N.
// grid (N/128, M/128, splits), block 256. needs M%128 == 0, N%128 == 0, K%64 == 0
// and (K/64) % splits == 0
.visible .entry gemm_mx(
    .param .u64 pa,
    .param .u64 psa,
    .param .u64 pb,
    .param .u64 psb,
    .param .u64 pc,
    .param .u32 pm,
    .param .u32 pn,
    .param .u32 pk,
    .param .u64 pr,
    .param .u32 pf)
{
    .shared .align 16 .b8 sm[40960];
    .reg .pred  %p, %pbf, %pr;
    .reg .b32   %r<80>;
    .reg .b64   %rd<40>;
    .reg .f32   %f<64>;                         // accumulator (mi, ni, j) is f[16mi + 4ni + j]
    .reg .b32   %ra<16>;                        // A fragment (mi, j) is ra[4mi + j]
    .reg .b32   %rb<8>;                         // B fragment (ni, j) is rb[2ni + j]
    .reg .b16   %i<4>;                          // byte and thread ids

    ld.param.u64    %rd1, [pa];
    ld.param.u64    %rd2, [pb];
    ld.param.u64    %rd3, [pc];
    ld.param.u32    %r1, [pm];
    ld.param.u32    %r2, [pn];
    ld.param.u32    %r3, [pk];
    ld.param.u64    %rd30, [pr];
    setp.ne.u64     %pr, %rd30, 0;
    ld.param.u32    %r60, [pf];
    and.b32         %r61, %r60, 4;
    setp.ne.u32     %pbf, %r61, 0;
    mov.b16         %i0, 0;
    mov.b16         %i1, 1;
    mov.b16         %i2, 2;
    mov.b16         %i3, 3;
    mov.u32         %r4, %tid.x;
    shr.u32         %r5, %r4, 5;                // warp
    and.b32         %r6, %r4, 31;               // lane
    mov.u32         %r7, %ctaid.y;
    shl.b32         %r7, %r7, 7;                // bm
    mov.u32         %r8, %ctaid.x;
    shl.b32         %r8, %r8, 7;                // bn
    mov.u32         %r9, sm;

    // what this thread copies, 16 bytes at a time: rows r and r+64 of the A tile and
    // of the B tile, 16 k at (tid%4)*16. global rd5/rd7 (A), rd8/rd9 (B) -> shared
    // r16/r17, r18/r19
    shr.u32         %r10, %r4, 2;
    and.b32         %r11, %r4, 3;
    shl.b32         %r11, %r11, 4;
    cvt.u64.u32     %rd10, %r11;
    add.u32         %r12, %r7, %r10;
    mul.wide.u32    %rd4, %r12, %r3;
    add.u64         %rd4, %rd4, %rd10;
    add.u64         %rd5, %rd1, %rd4;
    shl.b32         %r13, %r3, 6;               // 64 rows
    cvt.u64.u32     %rd6, %r13;
    add.u64         %rd7, %rd5, %rd6;
    add.u32         %r12, %r8, %r10;
    mul.wide.u32    %rd4, %r12, %r3;
    add.u64         %rd4, %rd4, %rd10;
    add.u64         %rd8, %rd2, %rd4;
    add.u64         %rd9, %rd8, %rd6;
    mul.lo.u32      %r14, %r10, 80;
    add.u32         %r14, %r14, %r11;
    add.u32         %r16, %r9, %r14;
    add.u32         %r17, %r16, 5120;
